{
  "families": [
    "Copperplate",
    "SFMono-Regular"
  ],
  "scale": {
    "heading-1": {
      "fontFamily": "Copperplate",
      "fontSize": "300px",
      "fontWeight": "700",
      "lineHeight": null,
      "source": "css"
    },
    "heading-2": {
      "fontFamily": "Copperplate",
      "fontSize": "42px",
      "fontWeight": "700",
      "lineHeight": null,
      "source": "css"
    },
    "heading-3": {
      "fontFamily": "Copperplate",
      "fontSize": "var(--text-desktop-xl,32px)",
      "fontWeight": "700",
      "lineHeight": null,
      "source": "css"
    },
    "body": {
      "fontFamily": "SFMono-Regular",
      "fontSize": "1rem",
      "fontWeight": "400",
      "lineHeight": null,
      "source": "css"
    },
    "caption": {
      "fontFamily": "SFMono-Regular",
      "fontSize": "16px",
      "fontWeight": "400",
      "lineHeight": null,
      "source": "css"
    },
    "code": {
      "fontFamily": "SFMono-Regular",
      "fontSize": "14px",
      "fontWeight": "400",
      "lineHeight": null,
      "source": "css"
    }
  },
  "fontFaces": [
    {
      "family": "Copperplate",
      "src": "https://static.thcdn.com/fe/fonts/creed/Copperplate-Light.woff",
      "format": "woff",
      "weight": "300"
    },
    {
      "family": "Copperplate",
      "src": "https://s1.thcdn.com/enterprise/fonts/Copperplate/Copperplate-Medium.woff",
      "format": "woff",
      "weight": "500"
    },
    {
      "family": "BigCaslon",
      "src": "https://s1.thcdn.com/enterprise/fonts/BigCaslon/BigCaslon-Regular.woff",
      "format": "woff",
      "weight": "400"
    },
    {
      "family": "BigCaslon",
      "src": "https://static.thcdn.com/fe/fonts/creed/Big%20Caslon%20Bold.woff",
      "format": "woff",
      "weight": "700"
    },
    {
      "family": "Pinyon Script",
      "src": "https://s1.thcdn.com/fe/fonts/creed/pinyon-script-v11-latin-regular.woff",
      "format": "woff",
      "weight": "400"
    }
  ],
  "rules": {
    "maxSizesPerScreen": 4,
    "headingWeightRange": "600-700",
    "bodyWeight": 400,
    "lineHeightBody": 1.5,
    "lineHeightHeading": 1.2
  }
}